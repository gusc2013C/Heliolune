{
  "mcpServers": {
    "luna-pool": {
      "command": "node",
      "args": ["./scripts/server.mjs"],
      "cwd": ".",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 3600,
      "default_tools_approval_mode": "approve",
      "enabled_tools": ["initialize_pool", "start_task", "start_batch", "pool_status", "cost_dashboard"]
    },
    "luna-await": {
      "command": "node",
      "args": ["./scripts/await-server.mjs"],
      "cwd": ".",
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 4500,
      "default_tools_approval_mode": "approve",
      "enabled_tools": ["await_task"]
    }
  }
}
